# HTTP-only vhost for test-shape-shifter.sead.se.
#
# Purpose: serve the ACME challenge so certbot can issue the first certificate.
# Install this file as
#   /etc/nginx/sites-available/test-shape-shifter.sead.se
# enable it, reload nginx, run
#   sudo certbot certonly --webroot -w /var/www/html -d test-shape-shifter.sead.se
# then replace the installed file with test-shape-shifter.sead.se.
#
# The site stays behind Basic auth during this step, so nothing is exposed
# unauthenticated while the certificate is being issued.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream shape_shifter_test {
    server 127.0.0.1:8012;
}

server {
    listen 80;
    listen [::]:80;
    server_name test-shape-shifter.sead.se;

    access_log /var/log/nginx/test-shape-shifter.sead.se.access.log;
    error_log  /var/log/nginx/test-shape-shifter.sead.se.error.log warn;

    # Certbot must reach these files without credentials. auth_basic is set at
    # server level, so it has to be switched off for this location only.
    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
    }

    auth_basic "Shape Shifter";
    auth_basic_user_file /etc/nginx/htpasswd/shape-shifter;

    client_max_body_size 100M;

    location / {
        proxy_pass http://shape_shifter_test;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Authenticated-User $remote_user;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
