# Shape Shifter authorization bootstrap template
#
# Safe to commit: this file contains placeholder values only, and nothing copies
# it automatically. `make setup` does not create the live file, because it holds
# passwords. Install reviewed values by hand as the deployment user:
#
#   mkdir -p ~/config
#   install -m 600 ~/container/resources/authorization.env.example ~/config/authorization.env
#   nano ~/config/authorization.env
#
# scripts/deploy/bootstrap-authentication-and-authorization.sh reads this file
# from CONFIG_DIR, which defaults to ~/config, and never from this checkout or a
# repository secrets folder. Keep the installed copy at mode 600.
#
# Format: KEY=value, one per line, no quotes around the whole value and no
# trailing comments. Values that hold several principals are space-separated
# inside double quotes.

# ============================================================================
# NGINX authentication
# ============================================================================

# Password for the principals listed in AUTH_USERS.
AUTH_PASSWORD=replace-with-a-generated-password

# Space-separated htpasswd account names. These names are the principal IDs the
# application records, so they must match the manifest grants exactly.
AUTH_USERS="reader-principal"

# Administrator account and password. The bootstrap creates this account, and it
# is the account that receives the `admin` deployment role.
ADMIN_AUTH_USER=admin
ADMIN_AUTH_PASSWORD=replace-with-a-generated-password

# ============================================================================
# Principal rosters
# ============================================================================

# Space-separated principal IDs that receive the named deployment role. The
# bootstrap assigns these roles; leave a roster empty when no principal holds it.
PROJECT_MAINTAINERS="maintainer-principal"
PROJECT_CREATOR_AND_OPERATOR="creator-principal"

# ============================================================================
# Target environment
# ============================================================================

# Deployment user that owns the checkout and the configuration directory, named
# as it appears after /data in the deployment path.
DEPLOY_USER=test-shape-shifter.sead.se

# Audit actor recorded on every role assignment the bootstrap makes.
AUTHORIZATION_ACTOR=test-shape-shifter.sead.se

# ============================================================================
# Reviewed policy
# ============================================================================

# Approved authorization manifest. A relative name resolves inside CONFIG_DIR;
# use an absolute path only when the manifest deliberately lives elsewhere.
AUTHORIZATION_MANIFEST=authorization-manifest.yaml
