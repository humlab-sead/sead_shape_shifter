# Shape Shifter Backend Environment Configuration
#
# SUPERSEDED: use backend.env.example instead. That template matches the current
# backend settings (SHAPE_SHIFTER_* names, trusted-proxy authentication, state/
# authorization database) and is the file scripts/setup.sh copies into
# container-data/backend.env. This file is kept only for historical reference.
#
# Copy this file to container-data/backend.env and customize for your environment.
# Container will load these variables on startup.
#
# IMPORTANT: Keep backend.env secure:
#   chmod 600 container-data/backend.env

# ============================================================================
# Application Settings
# ============================================================================

# Application environment (development, staging, production)
ENVIRONMENT=production

# Debug mode (false for production)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# Database Connections
# ============================================================================

# Shape Shifter project database (where transformed data is stored)
SHAPE_SHIFTER_DB_URL=postgresql://user:password@postgres-host:5432/shape_shifter_db

# SEAD (Scientific Event and Analysis Database) connection
# Used for data export and integration
SHAPE_SHIFTER_SEAD_DB_URL=postgresql://user:password@sead-host:5432/sead_db

# PostgreSQL authentication file (optional, for password-less connections)
# Mount path: /app/.pgpass (mapped from container-data/.pgpass)
# Format: hostname:port:database:username:password
# Example: postgres-host:5432:*:username:password
PGPASSFILE=/app/.pgpass

# ============================================================================
# SEAD Integration Services
# ============================================================================

# SIMS (SEAD Information Management System) service URL
# Used for authentication and entity resolution
SHAPE_SHIFTER_SIMS_SERVICE_URL=https://sims.sead.se/api/v1

# SIMS API key (for service-to-service authentication)
# Request from SEAD administrators
SHAPE_SHIFTER_SIMS_API_KEY=your-api-key-here

# SEAD tools base URL (for data submission endpoints)
SHAPE_SHIFTER_SEAD_TOOLS_BASE_URL=https://sead-tools.sead.se

# ============================================================================
# Data Ingestion
# ============================================================================

# Allowed file types for data import (comma-separated)
ALLOWED_IMPORT_FORMATS=csv,xlsx,sql,json

# Maximum import file size (in MB)
MAX_IMPORT_SIZE=500

# Temporary storage for uploads
TMP_UPLOAD_DIR=/app/tmp

# ============================================================================
# Data Storage Paths
# ============================================================================

# Base directory for project configurations
PROJECTS_DIR=/app/projects

# Shared data directory (e.g., target models, dictionaries)
SHARED_DIR=/app/shared

# Output directory for generated files
OUTPUT_DIR=/app/output

# Logs directory
LOGS_DIR=/app/logs

# Backups directory
BACKUPS_DIR=/app/backups

# ============================================================================
# Security
# ============================================================================

# Secret key for session management (generate: python -c "import secrets; print(secrets.token_hex(32))")
# IMPORTANT: Change this to a unique value in production
SECRET_KEY=your-secret-key-here-change-in-production

# JWT token expiration (seconds)
JWT_EXPIRATION_SECONDS=3600

# CORS allowed origins (comma-separated)
# For NGINX reverse proxy on https://test-shape-shifter.sead.se
CORS_ALLOWED_ORIGINS=https://test-shape-shifter.sead.se,http://localhost:8012

# ============================================================================
# Frontend (Optional, can be overridden at build time)
# ============================================================================

# Frontend API base URL (empty = use same host as frontend)
# Leave empty when serving frontend from same backend
VITE_API_BASE_URL=

# Frontend environment
VITE_ENV=production

# Enable analytics (false in production unless explicitly needed)
VITE_ENABLE_ANALYTICS=false

# Enable debug mode (false in production)
VITE_ENABLE_DEBUG=false

# ============================================================================
# Advanced Options
# ============================================================================

# Database connection pool size
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Number of worker processes (default: auto-detect CPU cores)
# Adjust based on container resource limits
WORKERS=4

# Enable request logging
LOG_REQUESTS=true

# Email notifications (optional)
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-email-password
# NOTIFICATION_EMAIL=admin@example.com

# ============================================================================
# External Services (Optional)
# ============================================================================

# Redis for caching (optional)
# REDIS_URL=redis://redis-host:6379/0

# Sentry error tracking (optional)
# SENTRY_DSN=https://your-sentry-token@sentry.io/your-project-id

# ============================================================================
# Feature Flags
# ============================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable data validation
ENABLE_DATA_VALIDATION=true

# Enable reconciliation features
ENABLE_RECONCILIATION=true

# ============================================================================
# Notes
# ============================================================================

# 1. After updating this file:
#    cd ~/container
#    make restart
#
# 2. For PostgreSQL authentication without passwords, create .pgpass:
#    echo 'postgres-host:5432:*:username:password' > container-data/.pgpass
#    chmod 600 container-data/.pgpass
#
# 3. Generate SECRET_KEY:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 4. For SIMS/SEAD integration, contact SEAD administrators for:
#    - SIMS service credentials
#    - API keys and access tokens
#    - Approved entity types and scopes
#
# 5. Keep this file secure - it contains credentials:
#    chmod 600 container-data/backend.env
