# Deployment defaults for the Shape Shifter Podman container.
#
# This file is a generic template inside the replaceable checkout. Deployment
# setup copies it to CONFIG_DIR/deployment.env when that file does not exist;
# edit the deployed copy, never this file, and never expect live settings to
# live under the checkout. Three consumers read the same values:
#   - container/Makefile            make targets
#   - container/scripts/*.sh        build, up, down, logs, status, healthcheck
#   - container/podman-compose.yml  through the environment those two export
#
# CONFIG_DIR defaults to ~/config and DATA_DIR to ~/container-data, next to the
# ~/container checkout. A relative value in this file names a path next to the
# checkout, so DATA_DIR=container-data and DATA_DIR=../container-data both mean
# ~/container-data.
#
# Keep the format simple: KEY=value, one per line, no quotes and no trailing
# comments. The Makefile parses this file too, so a value containing '#' would
# be truncated at that character.
#
# Precedence for every value, highest first:
#   1. command line   make IMAGE_NAME=shape-shifter:dev up
#   2. environment    IMAGE_NAME=shape-shifter:dev make up
#   3. this file in CONFIG_DIR
#   4. the fallbacks built into the Makefile

# --- Container identity -----------------------------------------------------

# Name of the running container.
CONTAINER_NAME=shape-shifter

# Image that `make up` starts. `make build` tags its output from the git ref
# when the ref is not a release version, so GIT_REF=dev produces
# shape-shifter:dev. Set IMAGE_NAME to match the ref you build from, otherwise
# `make up` starts the previous image.
IMAGE_NAME=shape-shifter:latest

# podman-compose project name. Prefixes the container and network names.
COMPOSE_PROJECT_NAME=shapeshifter

# --- Ports and paths --------------------------------------------------------

# Host port for the backend. The container publishes it on the loopback
# interface only, so a reverse proxy is the sole external entry point.
HOST_PORT=8012

# Optional path overrides for tests or a controlled alternate layout. Normal
# deployments use $HOME/config and $HOME/container-data.
# CONFIG_DIR=/path/to/config
# DATA_DIR=/path/to/container-data

# --- Source -----------------------------------------------------------------

# Where `make build` fetches the application from. Use `make build-local` to
# build from a repository checkout instead.
GIT_REPO=https://github.com/humlab-sead/sead_shape_shifter.git
GIT_REF=main

# --- Frontend build arguments -----------------------------------------------

# Baked into the frontend bundle at build time. The backend serves the frontend,
# so the API base URL stays empty for same-origin requests.
VITE_API_BASE_URL=
VITE_ENV=production
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# --- Multi-environment deploys ----------------------------------------------

# Environments for scripts/deploy/deploy_all_environments.sh, as USER:PORT pairs.
# The script takes this from its arguments, then this variable, and stops with
# usage text when neither is set. Only an administrator running that helper needs
# it; a single deployment can leave it unset.
# DEPLOY_ENVIRONMENTS=test-shape-shifter.sead.se:8012
