# Authorization group membership. Basic auth has no group claim of its own, so
# the group header the backend reads is derived from the authenticated user name.
# The included membership file holds one line per member, for example:
#
#     roger    sead-admins,strucke-editors;
#
# Membership lives in /etc/nginx/authz/groups.d/. The wildcard tolerates a
# missing directory or no matching file, so the header is empty until members
# are added. After editing membership:
#   sudo nginx -t && sudo systemctl reload nginx
map $remote_user $authz_groups {
    default "";
    include /etc/nginx/authz/groups.d/*.conf;
}

upstream shape_shifter {
    server 127.0.0.1:__UPSTREAM_PORT__;
}

server {
    listen 80;
    server_name __DOMAIN__;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # The backend runs with SHAPE_SHIFTER_TRUSTED_PROXY_AUTH_ENABLED=true in
    # production and reads the authenticated user from X-Authenticated-User.
    # Configure an authentication method here (for example auth_basic with an
    # htpasswd file) and NGINX will populate $remote_user, or replace the header
    # with the value supplied by your SSO proxy.
    #
    # To use group grants, also set SHAPE_SHIFTER_TRUSTED_PROXY_GROUPS_ENABLED=true
    # and SHAPE_SHIFTER_TRUSTED_PROXY_GROUPS_HEADER=X-Authenticated-Groups on the
    # backend. See docs/OPERATIONS.md for the membership file format.
    #
    # auth_basic "Shape Shifter";
    # auth_basic_user_file /etc/nginx/htpasswd/shape-shifter;

    location / {
        proxy_pass http://shape_shifter;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Authenticated-User $remote_user;

        # Authorization groups for this user; empty when the user is in none.
        proxy_set_header X-Authenticated-Groups $authz_groups;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        client_max_body_size 100M;
    }
}
