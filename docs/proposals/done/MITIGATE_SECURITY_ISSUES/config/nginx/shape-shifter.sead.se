server {
    server_name shape-shifter.sead.se;

    auth_basic "Restricted Area";
    auth_basic_user_file /etc/nginx/.htpasswd;
    client_max_body_size 50m;

    location / {
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Authenticated-User $remote_user;
        proxy_pass http://127.0.0.1:8012;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/shape-shifter.sead.se/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/shape-shifter.sead.se/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = shape-shifter.sead.se) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name shape-shifter.sead.se;

    listen 80;
    return 404; # managed by Certbot


}
