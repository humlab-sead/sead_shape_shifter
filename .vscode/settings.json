{
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.defaultFormatter": "darkriszty.markdown-table-prettify"
    },
    "[sql]": {
        "editor.defaultFormatter": "sqlfluff.vscode-sqlfluff"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "chat.tools.terminal.autoApprove": {
        "gh": true,
        "git add": true,
        "git commit": true
    },
    "chat.tools.urls.autoApprove": {
        "https://*.cytoscape.org": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://js.cytoscape.org": {
            "approveRequest": true,
            "approveResponse": false
        }
    },
    "chat.viewSessions.orientation": "stacked",
    "editor.hover.delay": 1400,
    "editor.minimap.enabled": false,
    "files.autoSave": "afterDelay",
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/data/**": true
    },    
    "git.confirmSync": false,
    "gitlens.rebaseEditor.ordering": "asc",
    "markdownlint.config": {
        "MD007": false,
        "MD013": {
            "line_length": -1
        },
        "MD024": false,
        "MD029": false,
        "MD032": false
    },
    "mcp": {
        "servers": {
            "vuetify-mcp": {
                "args": [
                    "-y",
                    "@vuetify/mcp"
                ],
                "command": "npx"
            }
        }
    },
    "peacock.remoteColor": "#336c73",
    // "python.analysis.logLevel": "Trace",
    "python.analysis.aiHoverSummaries": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.disableTaggedHints": true,
    "python.analysis.exclude": [
        "**/.*",
        "**/__pycache__/**",
        "**/.pytest_cache/**",
        "**/.ruff_cache/**",
        "**/.mypy_cache/**",
        "**/.git/**",
        "**/.tox/**",
        "**/.nox/**",
        "**/.venv/**",
        "**/venv/**",
        "**/env/**",
        "**/coverage/**",
        "**/dist/**",
        "**/build/**",
        "**/node_modules/**",
        "**/.vite/**",
        "**/tmp/**",
        "htmlcov/**",
        "**/*.egg-info/**",

        "docs/**",
        "docker/**",
        "deprecated/**",
        "data/**",
        "**/output/**",
        "**/backups/**",

        "sead-tools/**",
        "frontend/**",
        "./frontend/node_modules/.pnpm/**",
        "**/frontend/node_modules/**",
        "backend/tests/test_data/**",
    ],
    "python.analysis.include": [
        "src",
        "tests",
        "backend/app",
        "backend/tests",
        "ingesters",
    ],
    "python.analysis.extraPaths": [
        ".",
        // "backend"
    ],
    "python.analysis.autoSearchPaths": false,
    "python.analysis.generateWithTypeAnnotation": true,
    "python.analysis.importFormat": "absolute",
    "python.analysis.indexing": true,
    "python.analysis.inlayHints.callArgumentNames": "off",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.typeEvaluation.deprecateTypingAliases": true,
    "python.analysis.typeEvaluation.disableBytesTypePromotions": false,
    "python.analysis.userFileIndexingLimit": 1000,
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
    "python.testing.pytestArgs": [
        "tests",
        "backend/tests",
        "ingesters/sead/tests"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "search.exclude": {
        "**/htmlcov": true,
        "**/.venv": true,
        "**//__pycache__": true,
        "**/venv": true,
        "**/node_modules": true,
        "**/data": true,
        "**/tmp": true
    },
    "search.maxResults": 20000,
    "search.useIndexing": true,
    "terminal.integrated.tabs.location": "left",
    "testing.defaultGutterClickAction": "debug",
    "testing.gutterEnabled": true,
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#b41706",
        "activityBar.background": "#b41706",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#011f04",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#b41706",
        "statusBar.background": "#831104",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#b41706",
        "statusBarItem.remoteBackground": "#831104",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#831104",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#83110499",
        "titleBar.inactiveForeground": "#e7e7e799"
    },
    "workbench.tree.indent": 18,
    "yaml.format.bracketSpacing": false,
    "yaml.format.enable": true,
    "yaml.format.printWidth": 4096,
    "yaml.format.proseWrap": "preserve",
    "yaml.format.singleQuote": false,
    "yaml.keyOrdering": false,
    "yaml.schemas": {
        "/home/roger/source/sead_shape_shifter/frontend/src/schemas/projectSchema.json": [
            "**/shapeshifter.yml"
        ]
    }
}