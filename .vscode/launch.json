{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "FastAPI Backend (Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [ "backend.app.main:app", "--host", "127.0.0.1", "--port", "8013", "--reload" ],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/backend",
                "SHAPE_SHIFTER_ENVIRONMENT": "development",
                "SHAPE_SHIFTER_TRUSTED_PROXY_AUTH_ENABLED": "false",
                "SHAPE_SHIFTER_DEVELOPMENT_PRINCIPAL_ID": "local-developer",
                "SHAPE_SHIFTER_AUTHORIZATION_DATABASE_PATH": "state/authorization-dev.sqlite3",
                "SHAPE_SHIFTER_AUTHORIZATION_DEV_BOOTSTRAP_HINT_ENABLED": "true"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "FastAPI Backend (No Reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [ "backend.app.main:app", "--host", "127.0.0.1", "--port", "8013" ],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/backend",
                "SHAPE_SHIFTER_ENVIRONMENT": "development",
                "SHAPE_SHIFTER_TRUSTED_PROXY_AUTH_ENABLED": "false",
                "SHAPE_SHIFTER_DEVELOPMENT_PRINCIPAL_ID": "local-developer",
                "SHAPE_SHIFTER_AUTHORIZATION_DATABASE_PATH": "state/authorization-dev.sqlite3",
                "SHAPE_SHIFTER_AUTHORIZATION_DEV_BOOTSTRAP_HINT_ENABLED": "true"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}