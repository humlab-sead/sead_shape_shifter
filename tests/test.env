# Shape Shifter Backend Environment Template
#
# Safe to commit: this file contains placeholder values only.
# Copy it to container-data/backend.env and replace the placeholders:
#
#   cp container/resources/backend.env.example ~/container-data/backend.env
#   chmod 600 ~/container-data/backend.env
#
# The container loads ../container-data/backend.env on startup. Never commit the
# resulting backend.env file, because it holds real credentials.
#
# Variable names match backend/app/core/config.py. Backend settings use the
# SHAPE_SHIFTER_ prefix. The SEAD_* names are not backend settings: project YAML
# files reference them as ${SEAD_HOST} and similar.

# ============================================================================
# Application
# ============================================================================

# Root folder used to resolve every relative path below. Use /app in the container.
SHAPE_SHIFTER_APPLICATION_ROOT=.

# Environment mode: development, production, or test.
SHAPE_SHIFTER_ENVIRONMENT=production

# FastAPI title shown in the generated API docs.
# SHAPE_SHIFTER_APPLICATION_NAME=Shape Shifter Project Editor

# URL prefix for API v1 endpoints.
# SHAPE_SHIFTER_API_V1_PREFIX=/api/v1

# ============================================================================
# File Storage Paths
# ============================================================================
# Relative paths resolve under SHAPE_SHIFTER_APPLICATION_ROOT. The container
# creates the project, shared data, and log directories on startup.

# Project YAML files, project uploads, backups, and generated output.
SHAPE_SHIFTER_PROJECTS_DIR=tests/test_data/projects

# Shared reference files used by project configuration.
SHAPE_SHIFTER_GLOBAL_DATA_DIR=tests/test_data/shared/shared-data

# Shared uploaded data-source files.
SHAPE_SHIFTER_GLOBAL_DATA_SOURCE_DIR=tests/test_data/shared/data-sources

# Application log files.
SHAPE_SHIFTER_LOG_DIR=logs

# ============================================================================
# Logging
# ============================================================================

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
SHAPE_SHIFTER_LOG_LEVEL=INFO

# SHAPE_SHIFTER_LOG_FILE_ENABLED=true
# SHAPE_SHIFTER_LOG_CONSOLE_ENABLED=true

SHAPE_SHIFTER_LOG_CONFIGURE_ON_STARTUP_ENABLED=true

# ============================================================================
# Authentication and Authorization
# ============================================================================

# Required in production. NGINX authenticates the user and forwards the verified
# identity in X-Authenticated-User. Startup fails when ENVIRONMENT=production and
# this is false.
SHAPE_SHIFTER_TRUSTED_PROXY_AUTH_ENABLED=true

# Header that carries the authenticated username. NGINX must overwrite it.
# SHAPE_SHIFTER_TRUSTED_PROXY_AUTH_HEADER=X-Authenticated-User

# Optional: accept verified group IDs from the same proxy.
# SHAPE_SHIFTER_TRUSTED_PROXY_GROUPS_ENABLED=false
# SHAPE_SHIFTER_TRUSTED_PROXY_GROUPS_HEADER=X-Authenticated-Groups

# SQLite authorization database. Stored on the mounted state/ volume so grants
# survive a container rebuild. Must be outside the project, log, and shared data
# directories. A relative path resolves under SHAPE_SHIFTER_APPLICATION_ROOT.
SHAPE_SHIFTER_AUTHORIZATION_DATABASE_PATH=state/authorization.sqlite3

# Required in production: JSON array with at least one administrator principal ID.
SHAPE_SHIFTER_AUTHORIZATION_BOOTSTRAP_ADMIN_PRINCIPALS=["admin@example.com"]

# Allow grants to every authenticated principal. Keep false unless approved.
# SHAPE_SHIFTER_AUTHORIZATION_ALLOW_AUTHENTICATED_EVERYONE=false

# Trusted membership endpoint template containing {group_id}, used for group review.
# SHAPE_SHIFTER_AUTHORIZATION_MEMBERSHIP_LOOKUP_URL=https://example.com/members/{group_id}
# SHAPE_SHIFTER_AUTHORIZATION_MEMBERSHIP_PROVIDER=trusted-membership-provider
# SHAPE_SHIFTER_AUTHORIZATION_MEMBERSHIP_LOOKUP_TIMEOUT_SECONDS=5.0

# Development and test only. Startup fails when ENVIRONMENT=production.
# SHAPE_SHIFTER_DEVELOPMENT_PRINCIPAL_ID=

# ============================================================================
# Browser Access (CORS)
# ============================================================================

# JSON array of allowed browser origins. Set the public host name of this
# deployment. The built-in defaults allow only local development servers.
SHAPE_SHIFTER_ALLOWED_ORIGINS='["https://test-shape-shifter.sead.se","http://localhost:8012"]'

# Optional CORS regex. Leave unset unless a controlled wildcard is required.
# SHAPE_SHIFTER_ALLOWED_ORIGIN_REGEX=

# ============================================================================
# SEAD Integration Services
# ============================================================================

# SIMS (SEAD Information Management System) service URL, used for identity lookups.
# host.docker.internal points at the deployment host from inside the container.
# SHAPE_SHIFTER_SIMS_SERVICE_URL=http://host.docker.internal:8000

# OpenRefine reconciliation service URL.
# SHAPE_SHIFTER_RECONCILIATION_SERVICE_URL=http://host.docker.internal:8000

# ============================================================================
# SEAD Database Variables
# ============================================================================
# These names are unprefixed. Project YAML references them as ${SEAD_HOST} and
# similar, and the data source policy accepts the SEAD_ and SHAPE_SHIFTER_
# prefixes when it resolves environment variables in project configuration.

# SEAD database host, port, database name, and user.
SEAD_HOST=db.example.com
SEAD_PORT=5432
SEAD_DBNAME=sead_production
SEAD_USER=sead_user

# Comma-separated prefixes that project YAML may reference through ${VAR}.
# SHAPE_SHIFTER_DATA_SOURCE_ALLOWED_ENV_VAR_PREFIXES=SEAD_,SHAPE_SHIFTER_


# ============================================================================
# Ingesters
# ============================================================================

# Directories scanned for ingester modules.
# SHAPE_SHIFTER_INGESTER_PATHS='["ingesters"]'

# Comma-separated ingester keys to enable. Leave unset to enable all discovered.
# SHAPE_SHIFTER_ENABLED_INGESTERS=

# ============================================================================
# Processing Behavior
# ============================================================================

# Enable foreign key candidate suggestions in the editor.
# SHAPE_SHIFTER_ENABLE_FK_SUGGESTIONS=false

# Row count below which materialized data is stored inline in YAML.
# SHAPE_SHIFTER_MATERIALIZATION_INLINE_THRESHOLD=20

# Start the JVM used by UCanAccess for MS Access files. Requires lib/ucanaccess
# to be present in the image (run `make install-ucanaccess` before `make build`).
# SHAPE_SHIFTER_UCANACCESS_JVM_STARTUP_ENABLED=true

# ============================================================================
# Frontend Build Settings
# ============================================================================
# The frontend is compiled into the image, so these are build arguments for the
# Containerfile or podman-compose, not runtime settings. Setting them here has no
# effect after the image is built.

# VITE_API_BASE_URL=    # Leave empty when the backend serves the built frontend.

