# Shape Shifter environment template.
#
# Usage:
#   cp .env.example .env
# then adjust for your machine. The real .env is git-ignored and must never
# be committed. Keep secrets out of this file: the SEAD database password
# belongs in ~/.pgpass.

# ---------------------------------------------------------------------------
# SEAD database
# ---------------------------------------------------------------------------
# Project YAML files reference these as ${SEAD_HOST}, ${SEAD_PORT},
# ${SEAD_DBNAME}, and ${SEAD_USER}.
# Password: ~/.pgpass (chmod 600), format:
#   host:port:dbname:user:password
# See https://www.postgresql.org/docs/current/libpq-pgpass.html
SEAD_HOST=your-db-host
SEAD_DBNAME=sead_staging
SEAD_USER=your-db-user
SEAD_PORT=9023

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
SHAPE_SHIFTER_APPLICATION_ROOT="data"
SHAPE_SHIFTER_PROJECT_NAME="Shape Shifter Project Editor"
SHAPE_SHIFTER_ENVIRONMENT="development"
SHAPE_SHIFTER_API_V1_PREFIX="/api/v1"

SHAPE_SHIFTER_PROJECTS_DIR="projects"
SHAPE_SHIFTER_GLOBAL_DATA_DIR="shared/shared-data"
SHAPE_SHIFTER_GLOBAL_DATA_SOURCE_DIR="shared/data-sources"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
SHAPE_SHIFTER_LOG_DIR="logs"
SHAPE_SHIFTER_LOG_LEVEL="DEBUG"
SHAPE_SHIFTER_LOG_FILE_ENABLED=true
SHAPE_SHIFTER_LOG_CONSOLE_ENABLED=true
SHAPE_SHIFTER_LOG_ROTATION="10 MB"
SHAPE_SHIFTER_LOG_RETENTION="30 days"
SHAPE_SHIFTER_LOG_COMPRESSION="zip"
SHAPE_SHIFTER_LOG_FILTER_FRAMEWORK_FRAMES=true

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# Use host.docker.internal inside containers, localhost for local development.
SHAPE_SHIFTER_RECONCILIATION_SERVICE_URL="http://host.docker.internal:8000"
SHAPE_SHIFTER_SIMS_SERVICE_URL="http://localhost:8000"

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origins allowed to call the API. Add devtunnel URLs as needed.
SHAPE_SHIFTER_ALLOWED_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]'

# ---------------------------------------------------------------------------
# Ingesters
# ---------------------------------------------------------------------------
SHAPE_SHIFTER_INGESTER_PATHS='["ingesters"]'

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# API key for the user-facing release notes workflow. Leave empty unless
# needed; set the real value only in your local .env.
RELEASE_NOTES_API_KEY=""
