#!/usr/bin/env bash
# Synchronize the local container deployment files to the test environment.
set -euo pipefail

g_script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# This script lives in the source-only deployment/container-host/ tree, outside
# the runtime bundle, so the bundle it synchronizes is the sibling
# deployment/container/ directory.
g_container_dir="$(CDPATH= cd -- "$g_script_dir/../../container" && pwd)"
g_deploy_user="${DEPLOY_USER:-test-shape-shifter.sead.se}"
g_deploy_host="${DEPLOY_HOST:-}"
g_deploy_ssh_user="${DEPLOY_SSH_USER:-${USER:-}}"
g_remote_dir="${REMOTE_DIR:-container}"
g_dry_run=false

usage() {
  cat <<'EOF'
Usage: deployment/container-host/deploy/sync-to-deploy [--dry-run]
§
Synchronize the local container/ directory to the deployment user's
container directory and install/reload its systemd user unit. With no DEPLOY_HOST, synchronize on the current host.
With DEPLOY_HOST, use DEPLOY_SSH_USER for SSH transport. Files removed
locally are removed from the target. The target files are owned by
DEPLOY_USER and grouped to that user's primary group; the source group is
not copied.

Defaults:
  owner: DEPLOY_USER=test-shape-shifter.sead.se
  group: primary group of DEPLOY_USER (from the passwd entry)
  host: DEPLOY_HOST (empty means the current host)
  SSH user: DEPLOY_SSH_USER=$USER (remote mode only)
  path: REMOTE_DIR=container (relative to the remote user's home)

The production release path is not synchronized from a working tree. A managed
~/container selection is refused, and this command is for isolated development
only. Use an explicit non-production directory such as:

  --remote-dir container-dev

The service is not restarted or enabled by this command. Use the service
commands separately after reviewing the synchronized files.

Options:
  --deploy-user USER       Target owner. Default: $g_deploy_user
  --deploy-host HOST       SSH host; empty means the current host
  --deploy-ssh-user USER   SSH transport account for remote mode
  --remote-dir DIR         Target directory relative to the owner's home
  --dry-run                Show changes without modifying the target
  -h, --help               Show this help message

Examples:
  deployment/container-host/deploy/sync-to-deploy
  deployment/container-host/deploy/sync-to-deploy --dry-run
  DEPLOY_USER=test-shape-shifter.sead.se DEPLOY_HOST=deploy.example.org \
    DEPLOY_SSH_USER=deploy-admin deployment/container-host/deploy/sync-to-deploy
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --deploy-user)
      [[ $# -ge 2 ]] || { echo "--deploy-user requires a value." >&2; exit 1; }
      g_deploy_user="$2"
      shift 2
      ;;
    --deploy-host)
      [[ $# -ge 2 ]] || { echo "--deploy-host requires a value." >&2; exit 1; }
      g_deploy_host="$2"
      shift 2
      ;;
    --deploy-ssh-user)
      [[ $# -ge 2 ]] || { echo "--deploy-ssh-user requires a value." >&2; exit 1; }
      g_deploy_ssh_user="$2"
      shift 2
      ;;
    --remote-dir)
      [[ $# -ge 2 ]] || { echo "--remote-dir requires a value." >&2; exit 1; }
      g_remote_dir="$2"
      shift 2
      ;;
    --dry-run) g_dry_run=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

command -v rsync >/dev/null || { echo "rsync is required locally." >&2; exit 1; }

# Refuses a local target that the release manager owns, so an isolated
# development sync cannot overwrite a selected release. The check runs through
# sudo, because the deployment user's home may not be readable by the caller.
refuse_managed_target() {
  local dest="$1" trimmed resolved
  trimmed="${dest%/}"
  if sudo test -L "$trimmed"; then
    echo "error: refusing to synchronize into $trimmed: it is a symlink, which is how the release manager selects a release." >&2
    echo "       Use --remote-dir container-dev for isolated development." >&2
    exit 1
  fi
  resolved="$(sudo readlink -f -- "$trimmed" 2>/dev/null || true)"
  case "$resolved" in
  /opt/shape-shifter/*)
    echo "error: refusing to synchronize into $trimmed: it resolves into administrator-owned release storage ($resolved)." >&2
    echo "       Use --remote-dir container-dev for isolated development." >&2
    exit 1
    ;;
  esac
}

# --no-group keeps the source group off the target; the deployment user's own
# group is applied after the transfer.
RSYNC_ARGS=(--archive --no-group --delete --delete-delay --human-readable --itemize-changes --exclude=/.env --exclude="deployment-verification")
if [[ "$g_dry_run" = true ]]; then
  RSYNC_ARGS+=(--dry-run)
fi

if [[ -z "$g_deploy_host" ]]; then
  command -v getent >/dev/null || { echo "getent is required for local sync." >&2; exit 1; }
  command -v sudo >/dev/null || { echo "sudo is required for local sync." >&2; exit 1; }
  deploy_record="$(getent passwd "$g_deploy_user")"
  [[ -n "$deploy_record" ]] || { echo "Cannot resolve local user: $g_deploy_user" >&2; exit 1; }
  deploy_home="$(printf '%s\n' "$deploy_record" | cut -d: -f6)"
  deploy_gid="$(printf '%s\n' "$deploy_record" | cut -d: -f4)"
  destination="$deploy_home/${g_remote_dir%/}/"
  refuse_managed_target "$destination"
  printf 'Synchronizing %s/ to local %s\n' "$g_container_dir" "$destination"
  sudo rsync "${RSYNC_ARGS[@]}" "$g_container_dir/" "$destination"
  if [[ "$g_dry_run" = false ]]; then
    sudo chown -R "$g_deploy_user:$deploy_gid" "$destination"
    sudo install -d -o "$g_deploy_user" -g "$deploy_gid" -m 700 "$deploy_home/.config/systemd/user"
    sudo install -o "$g_deploy_user" -g "$deploy_gid" -m 644 \
      "$g_container_dir/service/shape-shifter.service" \
      "$deploy_home/.config/systemd/user/shape-shifter.service"
    sudo -u "$g_deploy_user" -H env XDG_RUNTIME_DIR="/run/user/$(id -u "$g_deploy_user")" \
      systemctl --user daemon-reload
  fi
else
  command -v ssh >/dev/null || { echo "ssh is required for remote sync." >&2; exit 1; }
  [[ -n "$g_deploy_ssh_user" ]] || { echo "g_deploy_ssh_user is required for remote sync." >&2; exit 1; }
  TARGET="${g_deploy_ssh_user}@${g_deploy_host}"
  deploy_record="$(ssh "$TARGET" "getent passwd '$g_deploy_user'")"
  [[ -n "$deploy_record" ]] || { echo "Cannot resolve remote user: $g_deploy_user" >&2; exit 1; }
  deploy_home="$(printf '%s\n' "$deploy_record" | cut -d: -f6)"
  deploy_gid="$(printf '%s\n' "$deploy_record" | cut -d: -f4)"
  destination="$deploy_home/${g_remote_dir%/}/"
  if ssh "$TARGET" "sudo -n test -L '${destination%/}'"; then
    echo "error: refusing to synchronize into ${destination%/} on $TARGET: it is a symlink, which is how the release manager selects a release." >&2
    echo "       Use --remote-dir container-dev for isolated development." >&2
    exit 1
  fi
  resolved_remote="$(ssh "$TARGET" "sudo -n readlink -f -- '${destination%/}' 2>/dev/null || true") || true"
  case "$resolved_remote" in
  /opt/shape-shifter/*)
    echo "error: refusing to synchronize into ${destination%/} on $TARGET: it resolves into administrator-owned release storage ($resolved_remote)." >&2
    echo "       Use --remote-dir container-dev for isolated development." >&2
    exit 1
    ;;
  esac
  printf 'Synchronizing %s/ to %s:%s\n' "$g_container_dir" "$TARGET" "$destination"
  rsync "${RSYNC_ARGS[@]}" --rsync-path="sudo -n rsync" "$g_container_dir/" "$TARGET:$destination"
  if [[ "$g_dry_run" = false ]]; then
    ssh "$TARGET" "sudo -n chown -R '$g_deploy_user:$deploy_gid' '$destination'"
    ssh "$TARGET" "sudo -n install -d -o '$g_deploy_user' -g '$deploy_gid' -m 700 '$deploy_home/.config/systemd/user'"
    ssh "$TARGET" "sudo -n install -o '$g_deploy_user' -g '$deploy_gid' -m 644 '$destination/service/shape-shifter.service' '$deploy_home/.config/systemd/user/shape-shifter.service'"
    deploy_uid="$(ssh "$TARGET" "id -u '$g_deploy_user'")"
    ssh "$TARGET" "sudo -n -u '$g_deploy_user' -H env XDG_RUNTIME_DIR=/run/user/$deploy_uid systemctl --user daemon-reload"
  fi
fi

printf 'Synchronized files are owned by %s:%s.\n' "$g_deploy_user" "$deploy_gid"
[[ "$g_dry_run" = true ]] || printf 'Systemd unit installed and user daemon reloaded for %s.\n' "$g_deploy_user"
