# Shape Shifter reverse-proxy vhost template.
#
# install_nginx_reverse_proxy.sh renders this file, replacing __DOMAIN__,
# __UPSTREAM_PORT__, and __UPSTREAM_NAME__. The shared maps
# ($connection_upgrade, $authz_groups) live in
# /etc/nginx/conf.d/shape-shifter-maps.conf, installed by the same script, so
# enabling a second Shape Shifter site does not redefine them.
#
# The backend runs with SHAPE_SHIFTER_TRUSTED_PROXY_AUTH_ENABLED=true in
# production and rejects requests without X-Authenticated-User. Keep an
# authentication method enabled below (auth_basic shown, or your SSO proxy
# header): with auth_basic commented out, $remote_user is empty and the
# backend rejects every request.
#
# To use group grants, also set SHAPE_SHIFTER_TRUSTED_PROXY_GROUPS_ENABLED=true
# and SHAPE_SHIFTER_TRUSTED_PROXY_GROUPS_HEADER=X-Authenticated-Groups on the
# backend. See docs/OPERATIONS.md for the membership file format.
#
# Obtain the certificate before enabling this vhost. nginx fails to start when
# ssl_certificate points at a missing file. Use the bootstrap vhost and the
# certbot webroot method first:
#   sudo install_nginx_reverse_proxy.sh --bootstrap __DOMAIN__
#   sudo certbot certonly --webroot -w /var/www/html -d __DOMAIN__
#   sudo install_nginx_reverse_proxy.sh __DOMAIN__ <port>

upstream __UPSTREAM_NAME__ {
    server 127.0.0.1:__UPSTREAM_PORT__;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log warn;

    # Keeps certificate renewal working. Certbot renews without reloading
    # nginx, and this server block sets no auth_basic, so renewal reaches
    # these files without credentials.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Authentication boundary. The whole site, including /api/v1/docs and
    # /api/v1/openapi.json, requires a valid htpasswd user.
    auth_basic "Shape Shifter";
    auth_basic_user_file /etc/nginx/htpasswd/shape-shifter;

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log warn;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    client_max_body_size 100M;

    location / {
        proxy_pass http://__UPSTREAM_NAME__;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Identity handed to FastAPI. $remote_user is set by auth_basic above.
        proxy_set_header X-Authenticated-User $remote_user;

        # Authorization groups for this user; empty when the user is in none.
        # $authz_groups is defined in /etc/nginx/conf.d/shape-shifter-maps.conf.
        proxy_set_header X-Authenticated-Groups $authz_groups;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Normalization runs can take longer than the 60s default.
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
