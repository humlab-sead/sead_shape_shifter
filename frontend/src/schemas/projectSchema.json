{
  "$defs": {
    "ProjectMetadata": {
      "description": "Metadata about a project.",
      "properties": {
        "name": {
          "description": "Project name",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "shapeshifter-project",
          "description": "Project type identifier",
          "title": "Type"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project description",
          "title": "Description"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project version",
          "title": "Version"
        },
        "data_provider_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable SEAD data provider code for the project",
          "title": "Data Provider Code"
        },
        "provider_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable schema code for the project's data provider",
          "title": "Provider Schema"
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File path if loaded from file",
          "title": "File Path"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Creation timestamp (Unix timestamp)",
          "title": "Created At"
        },
        "modified_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last modification timestamp (Unix timestamp)",
          "title": "Modified At"
        },
        "is_valid": {
          "default": true,
          "description": "Whether project is valid",
          "title": "Is Valid",
          "type": "boolean"
        },
        "default_entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default source entity name",
          "title": "Default Entity"
        },
        "target_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target model spec: inline dict or @load: path string",
          "title": "Target Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProjectMetadata",
      "type": "object"
    },
    "ValidationCategory": {
      "description": "Category of validation check.",
      "enum": [
        "structural",
        "data",
        "performance",
        "conformance"
      ],
      "title": "ValidationCategory",
      "type": "string"
    },
    "ValidationError": {
      "description": "A validation error or warning.",
      "properties": {
        "severity": {
          "description": "Severity level",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Entity name where error occurred",
          "title": "Entity"
        },
        "branch_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Merged-entity branch name, if issue is branch-scoped",
          "title": "Branch Name"
        },
        "branch_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Merged-entity branch source, if issue is branch-scoped",
          "title": "Branch Source"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field name where error occurred",
          "title": "Field"
        },
        "message": {
          "description": "Error message",
          "title": "Message",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Error code for programmatic handling",
          "title": "Code"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Suggested fix",
          "title": "Suggestion"
        },
        "category": {
          "$ref": "#/$defs/ValidationCategory",
          "default": "structural",
          "description": "Validation category"
        },
        "priority": {
          "$ref": "#/$defs/ValidationPriority",
          "default": "medium",
          "description": "Validation priority"
        },
        "auto_fixable": {
          "default": false,
          "description": "Whether this issue can be auto-fixed",
          "title": "Auto Fixable",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Additional issue details",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "severity",
        "message"
      ],
      "title": "ValidationError",
      "type": "object"
    },
    "ValidationPriority": {
      "description": "Priority level for validation checks.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "ValidationPriority",
      "type": "string"
    }
  },
  "description": "Schema for Shape Shifter project configuration files",
  "properties": {
    "entities": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "Map of entity name to entity (raw dicts)",
      "title": "Entities",
      "type": "object"
    },
    "options": {
      "additionalProperties": true,
      "description": "Global options",
      "title": "Options",
      "type": "object"
    },
    "task_list": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Task list for entity progress tracking",
      "title": "Task List"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Project metadata"
    },
    "load_warnings": {
      "description": "Non-fatal normalization warnings detected while loading",
      "items": {
        "type": "string"
      },
      "title": "Load Warnings",
      "type": "array"
    },
    "load_errors": {
      "description": "Configuration errors detected while loading",
      "items": {
        "$ref": "#/$defs/ValidationError"
      },
      "title": "Load Errors",
      "type": "array"
    }
  },
  "title": "ShapeShifter Project Configuration",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
